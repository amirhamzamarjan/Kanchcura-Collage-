# ============================================
# KANCHKURA COLLEGE ERP - ENVIRONMENT VARIABLES
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kanchkura_college
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql

# JWT Configuration
JWT_SECRET=kanchkura_college_erp_jwt_secret_key_2025_secure
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=90d

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=10

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Backup Configuration
BACKUP_PATH=./database/backups
BACKUP_SCHEDULE=0 0 * * *
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Session
SESSION_TIMEOUT_MINUTES=30
